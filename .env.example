# ── Supabase ──────────────────────────────────────────────────────────────────
# Required for live mode. Leave blank to run in demo mode (localStorage only).
VITE_SUPABASE_URL=your_supabase_project_url
# The anon key is safe to expose — access is enforced by Row Level Security.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Anthropic API ─────────────────────────────────────────────────────────────
# PROTOTYPE ONLY: this key is exposed in the browser bundle.
# In production, move all Anthropic calls to a server-side Edge Function and
# remove this variable entirely. See KNOWN_LIMITATIONS.md #1.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Demo mode credentials ─────────────────────────────────────────────────────
# Used only when VITE_SUPABASE_URL is blank (demo/localhost mode).
# These values are injected into the Vite bundle — do not use real passwords.
# Defaults: admin123 / student123 (used if these vars are unset).
VITE_DEMO_ADMIN_PASSWORD=your_demo_admin_password
VITE_DEMO_STUDENT_PASSWORD=your_demo_student_password
